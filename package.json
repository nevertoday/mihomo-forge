{
  "name": "mihomo-forge",
  "version": "1.0.0",
  "description": "A privacy-first, browser-based Mihomo/OpenClash configuration studio that compiles multiple YAML snapshots into one maintainable config.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "keywords": [
    "mihomo",
    "clash",
    "openclash",
    "clash-meta",
    "yaml",
    "proxy",
    "rule-provider"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "lucide-vue-next": "^0.577.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.43",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "~5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nevertoday/mihomo-forge.git"
  }
}
